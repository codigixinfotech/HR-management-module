// EHCM - Enterprise Human Capital Management
// Prisma schema - Phase 1 (Foundation & Organization) + Phase 2 (Recruitment & Employee Lifecycle)
// Remaining 18 modules are scaffolded as NestJS module stubs and will extend this schema in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
  CONSULTANT
  PART_TIME
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  PROBATION
  NOTICE_PERIOD
}

enum ApprovalStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}

enum ComplianceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
  ONE_TIME
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  FILED
  OVERDUE
  WAIVED
}

enum AssetStatus {
  IN_STOCK
  ALLOCATED
  UNDER_MAINTENANCE
  RETIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------------------
// Module: Administration (Auth, Roles, Permissions, Audit)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  companyId         String?
  email             String    @unique
  passwordHash      String
  isActive          Boolean   @default(true)
  mustResetPassword Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  roles         UserRole[]
  employee      Employee?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  code        String  @unique
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([companyId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Module: Organization (multi-company, multi-branch)
// ---------------------------------------------------------------------------

model Company {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  legalName       String?
  shortName       String?
  entityType      String?
  parentCompanyId String?
  parentCompany   Company?  @relation("ParentCompany", fields: [parentCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subsidiaries    Company[] @relation("ParentCompany")

  // Registration Details
  cin  String?
  gst  String?
  pan  String?
  tan  String?
  msme String?

  // Location
  country           String
  state             String?
  city              String?
  timezone          String? @default("Asia/Kolkata")
  currency          String
  registeredAddress String?
  pincode           String?

  // Contact Information
  email   String?
  phone   String?
  website String?

  // Organization
  businessUnit    String?
  defaultBranchId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches                Branch[]
  departments             Department[]
  designations            Designation[]
  employees               Employee[]
  users                   User[]
  roles                   Role[]
  jobOpenings             JobOpening[]
  onboardingTemplateTasks OnboardingTemplateTask[]

  shiftTypes ShiftType[]
  holidays   Holiday[]
  leaveTypes LeaveType[]

  salaryComponents SalaryComponent[]
  payrollRuns      PayrollRun[]
  complianceTypes  ComplianceType[]
  complianceTasks  ComplianceTask[]

  assets          Asset[]
  safetyIncidents SafetyIncident[]
  ppeItems        PpeItem[]
  safetyAudits    SafetyAudit[]

  costCenters CostCenter[]
  payGrades   PayGrade[]

  @@map("companies")
}

model Branch {
  id              String   @id @default(cuid())
  companyId       String
  code            String
  name            String
  businessUnit    String?
  branchType      String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  manager         String?
  phone           String?
  email           String?
  timezone        String?
  workingCalendar String?
  shiftGroup      String?
  maxCapacity     Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments Department[]
  employees   Employee[]
  locations   Location[]
  costCenters CostCenter[]

  @@unique([companyId, code])
  @@map("branches")
}

model Location {
  id           String  @id @default(cuid())
  branchId     String
  code         String
  name         String
  buildingName String?
  floor        String?
  wing         String?
  roomCabin    String?

  // Address
  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  // Operations
  gps          String?
  workingHours String?
  shift        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@map("locations")
}

model Department {
  id                 String   @id @default(cuid())
  companyId          String
  branchId           String?
  code               String
  name               String
  type               String   @default("Functional")
  parentDepartmentId String?
  manager            String?
  costCenter         String?
  headcountCapacity  Int      @default(10)
  annualBudget       Float?
  effectiveFrom      DateTime @default(now())
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentDepartment Department?   @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[]  @relation("DepartmentHierarchy")
  designations     Designation[]
  employees        Employee[]
  jobOpenings      JobOpening[]
  costCenters      CostCenter[]
  payGrades        PayGrade[]

  @@unique([companyId, code])
  @@index([branchId])
  @@map("departments")
}

model Designation {
  id                     String   @id @default(cuid())
  companyId              String
  departmentId           String?
  code                   String
  title                  String
  grade                  String?
  jobFamily              String?
  reportingDesignationId String?
  employmentType         String?
  minSalary              Float?
  maxSalary              Float?
  effectiveFrom          DateTime @default(now())
  description            String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department           Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportingDesignation Designation?  @relation("DesignationHierarchy", fields: [reportingDesignationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subDesignations      Designation[] @relation("DesignationHierarchy")
  employees            Employee[]
  jobOpenings          JobOpening[]

  @@unique([companyId, code])
  @@index([departmentId])
  @@map("designations")
}

// ---------------------------------------------------------------------------
// Module: Organization — Cost Centers & Pay Grades
// ---------------------------------------------------------------------------

model CostCenter {
  id                String   @id @default(cuid())
  companyId         String
  code              String   @unique
  name              String
  type              String   @default("Department") // Support, Department, Project, Production
  branchId          String?
  departmentId      String?
  managerId         String? // Employee ID (string ref, not FK to avoid circular)
  managerName       String? // Denormalized display name
  budget            Decimal  @default(0) @db.Decimal(15, 2)
  headcountCapacity Int      @default(0)
  effectiveFrom     DateTime @default(now())
  description       String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@map("cost_centers")
}

model PayGrade {
  id            String   @id @default(cuid())
  companyId     String
  businessUnit  String?
  gradeCode     String   @unique
  gradeName     String
  level         String   @default("L1") // L1, L2, L3, L4
  category      String   @default("Professional") // Executive, Management, Professional, Staff, Worker
  jobFamily     String?
  departmentId  String?
  minSalary     Decimal  @default(0) @db.Decimal(15, 2)
  maxSalary     Decimal  @default(0) @db.Decimal(15, 2)
  currency      String   @default("INR")
  effectiveFrom DateTime @default(now())
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([departmentId])
  @@map("pay_grades")
}

// ---------------------------------------------------------------------------
// Module: Employee Management
// ---------------------------------------------------------------------------

model Employee {
  id                 String  @id @default(cuid())
  employeeCode       String
  companyId          String
  branchId           String?
  departmentId       String?
  designationId      String?
  userId             String? @unique
  reportingManagerId String?

  firstName             String
  middleName            String?
  lastName              String
  gender                Gender?
  dateOfBirth           DateTime?
  personalEmail         String?
  workEmail             String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?

  dateOfJoining  DateTime?
  employmentType EmploymentType @default(PERMANENT)
  status         EmployeeStatus @default(ACTIVE)
  dateOfExit     DateTime?

  businessUnit                 String?
  location                     String?
  grade                        String?
  level                        String?
  shift                        String?
  costCenter                   String?
  employeeCategory             String?
  workPhone                    String?
  workMode                     String?   @default("Onsite")
  probationPeriod              String?
  confirmationDate             DateTime?
  emergencyContactRelationship String?

  maritalStatus    String?
  nationality      String?
  bloodGroup       String?
  religion         String?
  currentAddress   String?
  permanentAddress String?

  familyMemberName    String?
  familyRelationship  String?
  familyDob           DateTime?
  familyContact       String?
  nomineeName         String?
  nomineeRelationship String?
  nomineeShare        Float?

  educationQualification  String?
  educationSpecialization String?
  educationInstitution    String?
  educationUniversity     String?
  educationPassingYear    Int?
  educationPercentage     Float?

  prevCompany          String?
  prevJobTitle         String?
  prevStartDate        DateTime?
  prevEndDate          DateTime?
  prevTotalExp         String?
  prevReasonForLeaving String?

  bankName              String?
  bankAccountNumber     String?
  bankIfscCode          String?
  bankBranchName        String?
  bankAccountHolderName String?

  aadhaarNumber       String?
  panNumber           String?
  passportNumber      String?
  kycStatus           String?   @default("PENDING")
  kycVerificationDate DateTime?

  uanNumber         String?
  pfMemberId        String?
  esicNumber        String?
  pfApplicable      Boolean   @default(false)
  esicApplicable    Boolean   @default(false)
  pfEsicJoiningDate DateTime?

  salaryGrade         String?
  salaryBand          String?
  basicSalary         Float?
  hra                 Float?
  conveyance          Float?
  specialAllowance    Float?
  otherAllowances     Float?
  grossSalary         Float?
  annualCtc           Float?
  salaryEffectiveFrom DateTime?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pincode      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportingManager Employee?    @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports    Employee[]   @relation("ReportingManager")

  documents         EmployeeDocument[]
  onboardingTasks   EmployeeOnboardingTask[]
  courseEnrollments CourseEnrollment[]
  kpis              EmployeeKpi[]
  hrNotes           EmployeeHrNote[]
  timelineEvents    CareerTimelineEvent[]

  shiftAssignments      ShiftAssignment[]
  attendanceRecords     AttendanceRecord[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]     @relation("LeaveRequestEmployee")
  leaveRequestsApproved LeaveRequest[]     @relation("LeaveRequestApprover")

  salaryComponents     EmployeeSalaryComponent[]
  payslips             Payslip[]
  filedComplianceTasks ComplianceTask[]

  currentAssets     Asset[]
  assetAllocations  AssetAllocation[]
  reportedIncidents SafetyIncident[]
  ppeIssuances      PpeIssuance[]
  employeeTransfers EmployeeTransfer[]

  @@unique([companyId, employeeCode])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@map("employees")
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  docType    String
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

model CourseEnrollment {
  id             String    @id @default(cuid())
  employeeId     String
  courseName     String
  courseType     String
  enrollmentDate DateTime  @default(now())
  completionDate DateTime?
  status         String    @default("In Progress")
  certification  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("course_enrollments")
}

model EmployeeKpi {
  id                String   @id @default(cuid())
  employeeId        String
  kpi               String
  category          String
  target            String
  weightage         Float
  reviewPeriod      String
  performanceRating Float?
  managerFeedback   String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_kpis")
}

model EmployeeHrNote {
  id          String   @id @default(cuid())
  employeeId  String
  note        String   @db.Text
  noteType    String
  createdBy   String
  createdDate DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_hr_notes")
}

model CareerTimelineEvent {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @default(now())
  eventTitle String
  details    String?  @db.Text
  eventType  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("career_timeline_events")
}

model OnboardingTemplateTask {
  id          String  @id @default(cuid())
  companyId   String
  title       String
  description String?
  ownerType   String
  sequence    Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("onboarding_template_tasks")
}

model EmployeeOnboardingTask {
  id          String         @id @default(cuid())
  employeeId  String
  title       String
  description String?
  ownerType   String
  status      ApprovalStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_onboarding_tasks")
}

// ---------------------------------------------------------------------------
// Module: Recruitment (minimal Phase 2 subset: opening -> candidate -> offer)
// ---------------------------------------------------------------------------

model JobOpening {
  id            String   @id @default(cuid())
  companyId     String
  departmentId  String?
  designationId String?
  title         String
  description   String?  @db.Text
  numPositions  Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  candidates  Candidate[]

  @@index([companyId])
  @@map("job_openings")
}

model Candidate {
  id           String         @id @default(cuid())
  jobOpeningId String
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumePath   String?
  stage        CandidateStage @default(APPLIED)
  aiMatchScore Float?
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([jobOpeningId])
  @@map("candidates")
}

// ---------------------------------------------------------------------------
// Module: Workforce Management (shift master + shift roster)
// ---------------------------------------------------------------------------

model ShiftType {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  startTime    String
  endTime      String
  breakMinutes Int      @default(0)
  isNightShift Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments       ShiftAssignment[]
  attendanceRecords AttendanceRecord[]

  @@unique([companyId, code])
  @@map("shift_types")
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  companyId     String
  employeeId    String
  shiftTypeId   String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([shiftTypeId])
  @@map("shift_assignments")
}

// ---------------------------------------------------------------------------
// Module: Attendance & Leave
// ---------------------------------------------------------------------------

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  name      String
  date      DateTime @db.Date
  type      String   @default("PUBLIC")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@map("holidays")
}

model LeaveType {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  isPaid       Boolean  @default(true)
  annualQuota  Float    @default(0)
  carryForward Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Float    @default(0)
  used        Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String         @id @default(cuid())
  companyId       String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  totalDays       Float
  reason          String?        @db.Text
  status          ApprovalStatus @default(PENDING)
  approverId      String?
  approverRemarks String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employee  Employee  @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approver  Employee? @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  companyId     String
  employeeId    String
  date          DateTime         @db.Date
  shiftTypeId   String?
  checkIn       DateTime?
  checkOut      DateTime?
  workedMinutes Int?
  status        AttendanceStatus @default(PRESENT)
  source        String           @default("MANUAL")
  remarks       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftType ShiftType? @relation(fields: [shiftTypeId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Module: Payroll
// ---------------------------------------------------------------------------

model SalaryComponent {
  id          String              @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        SalaryComponentType
  isStatutory Boolean             @default(false)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments       EmployeeSalaryComponent[]
  payslipComponents PayslipComponent[]

  @@unique([companyId, code])
  @@map("salary_components")
}

model EmployeeSalaryComponent {
  id                String   @id @default(cuid())
  employeeId        String
  salaryComponentId String
  monthlyAmount     Float
  effectiveFrom     DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, salaryComponentId])
  @@map("employee_salary_components")
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String
  month       Int
  year        Int
  status      PayrollRunStatus @default(DRAFT)
  processedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([companyId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  grossEarnings   Float
  pf              Float    @default(0)
  esic            Float    @default(0)
  professionalTax Float    @default(0)
  otherDeductions Float    @default(0)
  netPay          Float
  createdAt       DateTime @default(now())

  payrollRun PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components PayslipComponent[]

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

model PayslipComponent {
  id                String              @id @default(cuid())
  payslipId         String
  salaryComponentId String?
  name              String
  type              SalaryComponentType
  amount            Float

  payslip         Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent? @relation(fields: [salaryComponentId], references: [id], onDelete: SetNull)

  @@index([payslipId])
  @@map("payslip_components")
}

// ---------------------------------------------------------------------------
// Module: Compliance
// ---------------------------------------------------------------------------

model ComplianceType {
  id          String              @id @default(cuid())
  companyId   String
  code        String
  name        String
  category    String
  frequency   ComplianceFrequency
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks   ComplianceTask[]

  @@unique([companyId, code])
  @@map("compliance_types")
}

model ComplianceTask {
  id               String           @id @default(cuid())
  companyId        String
  complianceTypeId String
  periodLabel      String
  dueDate          DateTime         @db.Date
  status           ComplianceStatus @default(PENDING)
  filedDate        DateTime?
  filedById        String?
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complianceType ComplianceType @relation(fields: [complianceTypeId], references: [id], onDelete: Cascade)
  filedBy        Employee?      @relation(fields: [filedById], references: [id], onDelete: SetNull)

  @@index([companyId, dueDate])
  @@index([status])
  @@map("compliance_tasks")
}

// ---------------------------------------------------------------------------
// Module: Asset Management
// ---------------------------------------------------------------------------

model Asset {
  id                String      @id @default(cuid())
  companyId         String
  assetTag          String
  name              String
  category          String
  value             Float?
  status            AssetStatus @default(IN_STOCK)
  currentEmployeeId String?
  purchaseDate      DateTime?
  warrantyExpiry    DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currentEmployee Employee?                @relation(fields: [currentEmployeeId], references: [id], onDelete: SetNull)
  allocations     AssetAllocation[]
  maintenanceLogs AssetMaintenanceRecord[]

  @@unique([companyId, assetTag])
  @@map("assets")
}

model AssetAllocation {
  id          String    @id @default(cuid())
  assetId     String
  employeeId  String
  allocatedAt DateTime  @default(now())
  returnedAt  DateTime?
  remarks     String?

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_allocations")
}

model AssetMaintenanceRecord {
  id        String    @id @default(cuid())
  assetId   String
  issue     String
  startDate DateTime
  endDate   DateTime?
  cost      Float?
  createdAt DateTime  @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_maintenance_records")
}

// ---------------------------------------------------------------------------
// Module: Health, Safety & EHS
// ---------------------------------------------------------------------------

model SafetyIncident {
  id               String           @id @default(cuid())
  companyId        String
  location         String
  incidentType     String
  severity         IncidentSeverity
  occurredAt       DateTime
  description      String?          @db.Text
  correctiveAction String?          @db.Text
  status           IncidentStatus   @default(OPEN)
  reportedById     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportedBy Employee? @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([companyId, occurredAt])
  @@map("safety_incidents")
}

model PpeItem {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  category      String
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  issuances PpeIssuance[]

  @@map("ppe_items")
}

model PpeIssuance {
  id         String   @id @default(cuid())
  ppeItemId  String
  employeeId String
  quantity   Int
  issuedAt   DateTime @default(now())

  ppeItem  PpeItem  @relation(fields: [ppeItemId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([ppeItemId])
  @@index([employeeId])
  @@map("ppe_issuances")
}

model SafetyAudit {
  id        String   @id @default(cuid())
  companyId String
  location  String
  auditDate DateTime
  score     Float
  auditor   String
  findings  String?  @db.Text
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, auditDate])
  @@map("safety_audits")
}

model SkillCompetency {
  id             String   @id @default(cuid())
  name           String
  category       String
  certRequired   Boolean  @default(false)
  benchmarkScore String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("skill_competencies")
}

model EmployeeTransfer {
  id           String @id @default(cuid())
  employeeId   String
  movementType String // 'PROMOTION', 'DEPARTMENT_SHIFT', 'BRANCH_TRANSFER', 'PROMOTION_TRANSFER'

  // Previous states
  prevDepartmentId       String?
  prevDesignationId      String?
  prevGradeId            String?
  prevBranchId           String?
  prevReportingManagerId String?

  // Target states
  newDepartmentId       String?
  newDesignationId      String?
  newGradeId            String?
  newBranchId           String?
  newReportingManagerId String?

  effectiveDate DateTime
  reason        String   @db.Text
  remarks       String?  @db.Text
  status        String   @default("PENDING") // DRAFT, PENDING, APPROVED, REJECTED, EFFECTIVE, CANCELLED

  approvedBy       String?
  approvedDate     DateTime?
  rejectionReason  String?   @db.Text
  approvalComments String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_transfers")
}
