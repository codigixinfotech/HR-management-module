// EHCM - Enterprise Human Capital Management
// Prisma schema - Phase 1 (Foundation & Organization) + Phase 2 (Recruitment & Employee Lifecycle)
// Remaining 18 modules are scaffolded as NestJS module stubs and will extend this schema in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
  CONSULTANT
  PART_TIME
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  PROBATION
  NOTICE_PERIOD
  EXITED
}

enum ApprovalStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum CandidateStage {
  APPLIED
  SCREENING
  SHORTLISTED
  ASSESSMENT_ASSIGNED
  ASSESSMENT_COMPLETED
  ASSESSMENT_PASSED
  ASSESSMENT_FAILED
  ON_HOLD
  INTERVIEW
  OFFERED
  HIRED
  ONBOARDED
  REJECTED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  LATE_ARRIVING
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}

enum ComplianceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
  ONE_TIME
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  FILED
  OVERDUE
  WAIVED
}

enum AssetStatus {
  IN_STOCK
  ALLOCATED
  UNDER_MAINTENANCE
  RETIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ---------------------------------------------------------------------------
// Module: Administration (Auth, Roles, Permissions, Audit)
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  companyId         String?
  email             String    @unique
  passwordHash      String
  isActive          Boolean   @default(true)
  mustResetPassword Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  roles         UserRole[]
  employee      Employee?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  code        String  @unique
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([companyId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Module: Organization (multi-company, multi-branch)
// ---------------------------------------------------------------------------

model Company {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  legalName       String?
  shortName       String?
  entityType      String?
  parentCompanyId String?
  parentCompany   Company?  @relation("ParentCompany", fields: [parentCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subsidiaries    Company[] @relation("ParentCompany")

  // Registration Details
  cin  String?
  gst  String?
  pan  String?
  tan  String?
  msme String?

  // Location
  country           String
  state             String?
  city              String?
  timezone          String? @default("Asia/Kolkata")
  currency          String
  registeredAddress String?
  pincode           String?

  // Contact Information
  email   String?
  phone   String?
  website String?

  // Organization
  businessUnit    String?
  defaultBranchId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches                Branch[]
  departments             Department[]
  designations            Designation[]
  employees               Employee[]
  users                   User[]
  roles                   Role[]
  jobOpenings             JobOpening[]
  onboardingTemplateTasks OnboardingTemplateTask[]

  shiftTypes ShiftType[]
  holidays   Holiday[]
  leaveTypes LeaveType[]

  salaryComponents        SalaryComponent[]
  salaryStructureTemplates SalaryStructureTemplate[]
  salaryAssignments       EmployeeSalaryAssignment[]
  payrollRuns             PayrollRun[]
  complianceTypes  ComplianceType[]
  complianceTasks  ComplianceTask[]

  assets          Asset[]
  safetyIncidents SafetyIncident[]
  ppeItems        PpeItem[]
  safetyAudits    SafetyAudit[]

  costCenters CostCenter[]
  payGrades   PayGrade[]
  hrPolicies  HrPolicy[]
  manpowerPlans ManpowerPlan[]
  manpowerRequisitions ManpowerRequisition[]
  travelBookings       TravelBooking[]
  expenseClaims        ExpenseClaim[]
  pfConfiguration      PfConfiguration?
  pfMonthlyRuns        PfMonthlyRun[]

  @@map("companies")
}

model Branch {
  id              String   @id @default(cuid())
  companyId       String
  code            String
  name            String
  businessUnit    String?
  branchType      String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  manager         String?
  phone           String?
  email           String?
  timezone        String?
  workingCalendar String?
  shiftGroup      String?
  maxCapacity     Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments Department[]
  employees   Employee[]
  locations   Location[]
  costCenters CostCenter[]
  travelBookings TravelBooking[]
  assets Asset[]
  manpowerPlans ManpowerPlan[]
  manpowerRequisitions ManpowerRequisition[]

  @@unique([companyId, code])
  @@map("branches")
}

model Location {
  id           String  @id @default(cuid())
  branchId     String
  code         String
  name         String
  buildingName String?
  floor        String?
  wing         String?
  roomCabin    String?

  // Address
  address String?
  city    String?
  state   String?
  country String?
  pincode String?

  // Operations
  gps          String?
  workingHours String?
  shift        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@map("locations")
}

model Department {
  id                 String   @id @default(cuid())
  companyId          String
  branchId           String?
  code               String
  name               String
  type               String   @default("Functional")
  parentDepartmentId String?
  manager            String?
  costCenter         String?
  headcountCapacity  Int      @default(10)
  annualBudget       Float?
  effectiveFrom      DateTime @default(now())
  description        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentDepartment Department?   @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[]  @relation("DepartmentHierarchy")
  designations     Designation[]
  employees        Employee[]
  jobOpenings      JobOpening[]
  costCenters      CostCenter[]
  payGrades        PayGrade[]
  manpowerPlans    ManpowerPlan[]
  manpowerRequisitions ManpowerRequisition[]
  travelBookings       TravelBooking[]
  assets               Asset[]

  @@unique([companyId, code])
  @@index([branchId])
  @@map("departments")
}

model Designation {
  id                     String   @id @default(cuid())
  companyId              String
  departmentId           String?
  code                   String
  title                  String
  grade                  String?
  jobFamily              String?
  reportingDesignationId String?
  employmentType         String?
  minSalary              Float?
  maxSalary              Float?
  effectiveFrom          DateTime @default(now())
  description            String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department           Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportingDesignation Designation?  @relation("DesignationHierarchy", fields: [reportingDesignationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subDesignations      Designation[] @relation("DesignationHierarchy")
  employees            Employee[]
  jobOpenings          JobOpening[]
  manpowerPlans        ManpowerPlan[]
  travelBookings       TravelBooking[]

  @@unique([companyId, code])
  @@index([departmentId])
  @@map("designations")
}

// ---------------------------------------------------------------------------
// Module: Organization — Cost Centers & Pay Grades
// ---------------------------------------------------------------------------

model CostCenter {
  id                String   @id @default(cuid())
  companyId         String
  code              String   @unique
  name              String
  type              String   @default("Department") // Support, Department, Project, Production
  branchId          String?
  departmentId      String?
  managerId         String? // Employee ID (string ref, not FK to avoid circular)
  managerName       String? // Denormalized display name
  budget            Decimal  @default(0) @db.Decimal(15, 2)
  headcountCapacity Int      @default(0)
  effectiveFrom     DateTime @default(now())
  description       String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@map("cost_centers")
}

model PayGrade {
  id            String   @id @default(cuid())
  companyId     String
  businessUnit  String?
  gradeCode     String   @unique
  gradeName     String
  level         String   @default("L1") // L1, L2, L3, L4
  category      String   @default("Professional") // Executive, Management, Professional, Staff, Worker
  jobFamily     String?
  departmentId  String?
  minSalary     Decimal  @default(0) @db.Decimal(15, 2)
  maxSalary     Decimal  @default(0) @db.Decimal(15, 2)
  currency      String   @default("INR")
  effectiveFrom DateTime @default(now())
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([departmentId])
  @@map("pay_grades")
}

model HrPolicy {
  id               String   @id @default(cuid())
  companyId        String?
  policyCode       String
  title            String
  category         String   @default("Conduct") // Conduct, POSH, Workplace, IT Security, Financial
  description      String?  @db.Text
  version          String   @default("v1.0")
  documentUrl      String?
  fileSize         String?  @default("1.5 MB PDF")
  color            String?  @default("bg-primary")
  esignRequirement Boolean  @default(true)
  status           String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  totalEmployees   Int      @default(248)
  signedCount      Int      @default(0)
  publishedAt      DateTime @default(now())
  createdBy        String?  @default("HR Admin")
  updatedBy        String?  @default("HR Admin")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([policyCode])
  @@map("hr_policies")
}

// ---------------------------------------------------------------------------
// Module: Employee Management
// ---------------------------------------------------------------------------

model Employee {
  id                 String  @id @default(cuid())
  employeeCode       String
  companyId          String
  branchId           String?
  departmentId       String?
  designationId      String?
  userId             String? @unique
  reportingManagerId String?

  firstName             String
  middleName            String?
  lastName              String
  gender                Gender?
  dateOfBirth           DateTime?
  personalEmail         String?
  workEmail             String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?

  dateOfJoining  DateTime?
  employmentType EmploymentType @default(PERMANENT)
  status         EmployeeStatus @default(ACTIVE)
  dateOfExit     DateTime?

  businessUnit                 String?
  location                     String?
  grade                        String?
  level                        String?
  shift                        String?
  costCenter                   String?
  employeeCategory             String?
  workPhone                    String?
  workMode                     String?   @default("Onsite")
  probationPeriod              String?
  confirmationDate             DateTime?
  emergencyContactRelationship String?

  maritalStatus    String?
  nationality      String?
  bloodGroup       String?
  religion         String?
  currentAddress   String?
  permanentAddress String?

  familyMemberName    String?
  familyRelationship  String?
  familyDob           DateTime?
  familyContact       String?
  nomineeName         String?
  nomineeRelationship String?
  nomineeShare        Float?

  educationQualification  String?
  educationSpecialization String?
  educationInstitution    String?
  educationUniversity     String?
  educationPassingYear    Int?
  educationPercentage     Float?

  prevCompany          String?
  prevJobTitle         String?
  prevStartDate        DateTime?
  prevEndDate          DateTime?
  prevTotalExp         String?
  prevReasonForLeaving String?

  bankName              String?
  bankAccountNumber     String?
  bankIfscCode          String?
  bankBranchName        String?
  bankAccountHolderName String?

  aadhaarNumber       String?
  panNumber           String?
  passportNumber      String?
  kycStatus           String?   @default("PENDING")
  kycVerificationDate DateTime?

  uanNumber         String?
  pfMemberId        String?
  esicNumber        String?
  pfApplicable      Boolean   @default(false)
  esicApplicable    Boolean   @default(false)
  pfEsicJoiningDate DateTime?

  salaryGrade         String?
  salaryBand          String?
  basicSalary         Float?
  hra                 Float?
  conveyance          Float?
  specialAllowance    Float?
  otherAllowances     Float?
  grossSalary         Float?
  annualCtc           Float?
  salaryEffectiveFrom DateTime?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  pincode      String?

  faceTemplate       String?   @db.Text
  facePhoto          String?   @db.LongText
  faceRegisteredAt   DateTime?
  faceRegisteredBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reportingManager Employee?    @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports    Employee[]   @relation("ReportingManager")

  documents         EmployeeDocument[]
  onboardingTasks   EmployeeOnboardingTask[]
  courseEnrollments CourseEnrollment[]
  kpis              EmployeeKpi[]
  hrNotes           EmployeeHrNote[]
  timelineEvents    CareerTimelineEvent[]
  positionHistory   EmployeePositionHistory[]
  exits             EmployeeExit[]

  shiftAssignments      ShiftAssignment[]
  attendanceRecords     AttendanceRecord[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]     @relation("LeaveRequestEmployee")
  travelBookings        TravelBooking[]
  expenseClaims         ExpenseClaim[]
  leaveRequestsApproved LeaveRequest[]     @relation("LeaveRequestApprover")

  salaryComponents     EmployeeSalaryComponent[]
  salaryAssignments    EmployeeSalaryAssignment[]
  payslips             Payslip[]
  filedComplianceTasks ComplianceTask[]
  pfRecords            PfEmployeeRecord[]

  currentAssets     Asset[]
  assetAllocations  AssetAllocation[]
  reportedIncidents SafetyIncident[]
  ppeIssuances      PpeIssuance[]
  employeeTransfers EmployeeTransfer[]

  assignedTasks     EmployeeTask[]     @relation("TaskAssignedTo")
  createdTasks      EmployeeTask[]     @relation("TaskAssignedBy")
  taskRequests      TaskRequest[]

  interviewPanels      CandidateInterviewPanel[]
  interviewEvaluations CandidateInterviewEvaluation[]

  @@unique([companyId, employeeCode])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@map("employees")
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  docType    String
  fileName   String
  filePath   String
  uploadedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

model CourseEnrollment {
  id             String    @id @default(cuid())
  employeeId     String
  courseName     String
  courseType     String
  enrollmentDate DateTime  @default(now())
  completionDate DateTime?
  status         String    @default("In Progress")
  certification  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("course_enrollments")
}

model EmployeeKpi {
  id                String   @id @default(cuid())
  employeeId        String
  kpi               String
  category          String
  target            String
  weightage         Float
  reviewPeriod      String
  performanceRating Float?
  managerFeedback   String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_kpis")
}

model EmployeeHrNote {
  id          String   @id @default(cuid())
  employeeId  String
  note        String   @db.Text
  noteType    String
  createdBy   String
  createdDate DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_hr_notes")
}

model CareerTimelineEvent {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @default(now())
  eventTitle String
  details    String?  @db.Text
  eventType  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("career_timeline_events")
}

model OnboardingTemplateTask {
  id          String  @id @default(cuid())
  companyId   String
  title       String
  description String?
  ownerType   String
  sequence    Int     @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("onboarding_template_tasks")
}

model EmployeeOnboardingTask {
  id          String         @id @default(cuid())
  employeeId  String
  title       String
  description String?
  ownerType   String
  status      ApprovalStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_onboarding_tasks")
}

// ---------------------------------------------------------------------------
// Module: Recruitment (minimal Phase 2 subset: opening -> candidate -> offer)
// ---------------------------------------------------------------------------

model JobOpening {
  id                    String   @id @default(cuid())
  companyId             String
  departmentId          String?
  designationId         String?
  manpowerRequisitionId String?  @unique
  requisitionCode       String?
  manpowerPlanCode      String?
  mrNumber              String?
  title                 String
  description           String?  @db.Text
  responsibilities      String?  @db.Text
  numPositions          Int      @default(1)
  costCenter            String?
  employmentType        String?  @default("FULL_TIME")
  priority              String?  @default("NORMAL")
  candidateType         String?  @default("BOTH") // FRESHER, EXPERIENCED, BOTH
  minExperience         Float?   @default(0)
  maxExperience         Float?   @default(0)
  graduationYear        String?
  minSalary             Float?
  maxSalary             Float?
  qualification         String?
  experience            String?
  requiredSkills        String?
  workLocation          String?
  reportingManagerId    String?
  applicationDeadline   DateTime?
  status                String   @default("DRAFT") // DRAFT, PENDING_REVIEW, READY_TO_PUBLISH, PUBLISHED, CLOSED, CANCELLED
  publishedAt           DateTime?
  isActive              Boolean  @default(true)

  // Enterprise Recruitment Extensions
  workMode               String?  @default("On-site")
  hiringManagerId        String?
  recruiterId            String?
  hrbpId                 String?
  applicationStartDate   DateTime? @default(now())
  jobVisibility          String?  @default("Public")
  preferredSkills        String?
  preferredQualification String?
  certifications         String?
  languages              String?
  benefits               String?  @db.Text
  interviewProcess       String?  @db.Text
  numInterviewRounds     Int?     @default(3)
  hasAssessment          Boolean? @default(false)
  internalNotes          String?  @db.Text
  internalJustification  String?  @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation         Designation?         @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manpowerRequisition ManpowerRequisition? @relation(fields: [manpowerRequisitionId], references: [id], onDelete: SetNull)
  candidates          Candidate[]
  interviews          CandidateInterview[]
  atsAnalyses         AtsAnalysis[]

  @@index([companyId])
  @@map("job_openings")
}

model Candidate {
  id                   String         @id @default(cuid())
  jobOpeningId         String
  firstName            String
  lastName             String
  email                String
  phone                String?
  resumePath           String?        @db.Text
  candidateType        String?        @default("FRESHER") // FRESHER, EXPERIENCED
  qualification        String?
  graduationYear       String?
  internshipDetails    String?        @db.Text
  experience           String?
  currentCompany       String?
  currentLocation      String?
  skills               String?
  currentCtc           Float?
  expectedCtc          Float?
  noticePeriod         String?
  coverLetter          String?        @db.Text
  source               String?        @default("CAREERS_PORTAL")
  stage                CandidateStage @default(APPLIED)
  aiMatchScore         Float?
  notes                String?        @db.Text
  microsoftTeamsUserId String?
  teamsChatId          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  jobOpening           JobOpening                     @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  screenings           CandidateScreening[]
  interviews           CandidateInterview[]
  interviewEvaluations CandidateInterviewEvaluation[]
  atsAnalysis          AtsAnalysis?
  teamsMessages        CandidateTeamsMessage[]

  @@index([jobOpeningId])
  @@map("candidates")
