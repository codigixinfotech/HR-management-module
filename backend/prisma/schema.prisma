  companyId         String
  branchId          String?
  departmentId      String?
  assetTag          String
  name              String
  category          String
  assetType         String?     @default("Hardware")
  physicalLocation  String?
  vendor            String?
  invoiceNumber     String?
  poNumber          String?
  serialNumber      String?
  manufacturer      String?
  modelNumber       String?
  warrantyStart     DateTime?
  warrantyExpiry    DateTime?
