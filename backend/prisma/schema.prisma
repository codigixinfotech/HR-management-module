  approvedDate DateTime?
  reason       String?  @db.Text
  remarks      String?  @db.Text
  status       String   @default("CURRENT") // 'CURRENT', 'HISTORICAL'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_position_histories")
}

model EmployeeExit {
  id                  String    @id @default(cuid())
  exitCode            String    @unique
  employeeId          String
  companyId           String?
  
  resignationDate     DateTime
  noticePeriodDays    Int       @default(90)
  lastWorkingDay      DateTime
  adjustedLwd         DateTime?
  lwdAdjustmentReason String?   @db.Text
  
  exitType            String    @default("RESIGNATION")
  exitReason          String    @db.Text
  resignationLetterUrl String?
  remarks             String?   @db.Text

  status              String    @default("INITIATED")
  clearanceStatus     String    @default("PENDING")
  fnfStatus           String    @default("PENDING")
  exitInterviewStatus String    @default("PENDING")

  createdById         String?
  updatedById         String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clearanceItems      ExitClearanceItem[]
  exitInterview       ExitInterview?
  fnfSettlement       ExitFnfSettlement?
  auditLogs           ExitAuditLog[]

  @@index([employeeId])
  @@index([status])
  @@map("employee_exits")
}

model ExitClearanceItem {
  id          String   @id @default(cuid())
  exitId      String
  department  String
  itemKey     String
  itemLabel   String
  status      String   @default("PENDING")
  verifiedBy  String?
  verifiedAt  DateTime?
  remarks     String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exit        EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)

  @@index([exitId])
  @@map("exit_clearance_items")
}

model ExitInterview {
  id                    String    @id @default(cuid())
  exitId                String    @unique
  primaryReason         String
  secondaryReason       String?
  managerFeedback       String?   @db.Text
  employeeFeedback      String?   @db.Text
  workEnvironmentRating Int?      @default(5)
  compensationRating    Int?      @default(5)
  recommendCompany      Boolean   @default(true)
  rehireEligible        Boolean   @default(true)
  hrRemarks             String?   @db.Text
  completedAt           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  exit                  EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)

  @@map("exit_interviews")
}

model ExitFnfSettlement {
  id                  String    @id @default(cuid())
  exitId              String    @unique
  salaryPayable       Float     @default(0)
  leaveEncashment     Float     @default(0)
  incentives          Float     @default(0)
  reimbursements      Float     @default(0)
  noticeRecovery      Float     @default(0)
  loanAdvanceRecovery Float     @default(0)
  assetRecovery       Float     @default(0)
  otherDeductions     Float     @default(0)
  grossPayable        Float     @default(0)
  totalDeductions     Float     @default(0)
  netPayable          Float     @default(0)
  status              String    @default("PENDING")
  approvedBy          String?
  approvedAt          DateTime?
  remarks             String?   @db.Text

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  exit                EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)

  @@map("exit_fnf_settlements")
}

model ExitAuditLog {
  id             String   @id @default(cuid())
  exitId         String
  action         String
  previousStatus String?
  newStatus      String
  performedBy    String
  remarks        String?  @db.Text
  createdAt      DateTime @default(now())

  exit           EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)

  @@index([exitId])
  @@map("exit_audit_logs")
}

// ---------------------------------------------------------------------------
// Module: Task Management & Employee Task Allocation
// ---------------------------------------------------------------------------

model EmployeeTask {
  id                   String   @id @default(cuid())
  taskCode             String   @unique
  title                String
  description          String?  @db.Text
  taskType             String   @default("TASK") // TASK, FEATURE, BUG, RECRUITMENT, WORKFLOW, MAINTENANCE, HR_REQUEST
  departmentName       String?
  projectName          String?
  priority             String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  assignedToId         String
  assignedById         String
  departmentId         String?

  startDate            DateTime?
  dueDate              DateTime?
  estimatedHours       Float?   @default(0)
  actualHours          Float?   @default(0)

  attachments          String?  @db.Text
  instructions         String?  @db.Text
  managerRemarks       String?  @db.Text
  completionRemarks    String?  @db.Text
  completionAttachment String?  @db.Text
  rejectionReason      String?  @db.Text

  status               String   @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, ON_HOLD, COMPLETED, UNABLE_TO_COMPLETE, CLOSED, REOPENED
  progress             Int      @default(0) // 0 to 100

  startedAt            DateTime?
  completedAt          DateTime?
  closedAt             DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignedTo           Employee @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy           Employee @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  activities           TaskActivity[]

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@map("employee_tasks")
}

model TaskActivity {
  id             String       @id @default(cuid())
  taskId         String
  performedBy    String
  action         String
  previousStatus String?
  newStatus      String?
  progress       Int?
  remarks        String?      @db.Text
  createdAt      DateTime     @default(now())

  task           EmployeeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_activities")
}

model TaskRequest {
  id             String    @id @default(cuid())
  requestCode    String    @unique
  requestedById  String
  requestTitle   String
  requestType    String    @default("GENERAL") // GENERAL, RECRUITMENT, WORKFLOW, EQUIPMENT, ACCESS, HR_SUPPORT
  description    String?   @db.Text
  priority       String    @default("MEDIUM")
  status         String    @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, CONVERTED_TO_TASK, COMPLETED
  assignedTaskId String?
  reviewRemarks  String?   @db.Text
  reviewedBy     String?
  reviewedAt     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requestedBy    Employee  @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById])
  @@map("task_requests")
}

model TaskNotification {
  id          String   @id @default(cuid())
  employeeId  String
  title       String
  message     String   @db.Text
  type        String   @default("INFO") // NEW_TASK, DUE_SOON, OVERDUE, AWAITING_REVIEW, RETURNED
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@map("task_notifications")
}

// ---------------------------------------------------------------------------
// Module: Recruitment — Candidate Interviews, Panels & Evaluations
// ---------------------------------------------------------------------------

model CandidateInterview {
  id                   String   @id @default(cuid())
  interviewCode        String   @unique
  candidateId          String
  jobOpeningId         String?
  position             String
  requisitionCode      String?

  interviewDate        DateTime
  startTime            String
  endTime              String?
  durationMinutes      Int?     @default(60)
  interviewFormat      String   @default("Microsoft Teams") // Google Meet, On-site, Phone, Microsoft Teams
  meetingProvider      String?  @default("Microsoft Teams")
  meetingLink          String?  @db.Text
  teamsMeetingId       String?
  teamsJoinUrl         String?  @db.Text
  teamsMeetingLinkId   String?
  notes                String?  @db.Text

  status               String   @default("SCHEDULED") // READY_TO_SCHEDULE, SCHEDULED, IN_PROGRESS, COMPLETED, EVALUATION_PENDING, EVALUATED, CANCELLED, RESCHEDULED

  createdById          String?
  createdByName        String?  @default("HR Administrator")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  candidate            Candidate                      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening           JobOpening?                    @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  teamsMeetingLinkPool TeamsMeetingLinkPool?          @relation(fields: [teamsMeetingLinkId], references: [id], onDelete: SetNull)
  panelMembers         CandidateInterviewPanel[]
  evaluations          CandidateInterviewEvaluation[]

  @@index([candidateId])
  @@index([jobOpeningId])
  @@index([teamsMeetingLinkId])
  @@index([status])
  @@map("candidate_interviews")
}

model TeamsMeetingLinkPool {
  id          String               @id @default(cuid())
  title       String?              // e.g. "Teams Room 1"
  meetingUrl  String               @unique @db.VarChar(500)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  interviews  CandidateInterview[]

  @@map("teams_meeting_link_pool")
}

model CandidateInterviewPanel {
  id               String   @id @default(cuid())
  interviewId      String
  interviewerId    String
  interviewerName  String
  designation      String?
  department       String?
  panelRole        String   @default("Interviewer") // Technical Interviewer, HR Interviewer, Panel Member
  assignmentStatus String   @default("ASSIGNED") // ASSIGNED, CONFIRMED, COMPLETED
  createdAt        DateTime @default(now())

  interview   CandidateInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer Employee           @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@index([interviewerId])
  @@map("candidate_interview_panels")
}

model CandidateInterviewEvaluation {
  id                  String   @id @default(cuid())
  interviewId         String
  candidateId         String
  interviewerId       String
  interviewerName     String

  // 1-5 Scorecard ratings
  technicalSkills     Int      @default(3)
  communication       Int      @default(3)
  problemSolving      Int      @default(3)
  relevantExperience  Int      @default(3)
  roleKnowledge       Int      @default(3)
  overallRating       Float    @default(3.0)

  // Qualitative Feedback
  strengths           String?  @db.Text
  weaknesses          String?  @db.Text
  interviewNotes      String?  @db.Text
  recommendation      String   @default("Hire") // Strong Hire, Hire, Hold, Reject

  submittedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  interview   CandidateInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer Employee           @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@index([candidateId])
  @@index([interviewerId])
  @@map("candidate_interview_evaluations")
}

// ---------------------------------------------------------------------------
// Module: Travel & Expense Management
// ---------------------------------------------------------------------------

model TravelBooking {
  id                   String   @id @default(cuid())
  bookingCode          String   @unique
  companyId            String
  employeeId           String
  departmentId         String?
  designationId        String?
  branchId             String?
  costCenterId         String?
  gradeId              String?
  reportingManagerId   String?

  purpose              String
  travelType           String   @default("Domestic") // Domestic, International, Local
  fromLocation         String
  toLocation           String
  startDate            DateTime
  endDate              DateTime
  travelMode           String   @default("Flight") // Flight, Train, Bus, Car, Taxi

  accommodationRequired Boolean @default(false)
  hotelDetails          String?

  estimatedTravelCost     Decimal @default(0) @db.Decimal(12, 2)
  estimatedHotelCost      Decimal @default(0) @db.Decimal(12, 2)
  estimatedFoodCost       Decimal @default(0) @db.Decimal(12, 2)
  estimatedLocalTransport Decimal @default(0) @db.Decimal(12, 2)
  otherCost               Decimal @default(0) @db.Decimal(12, 2)
  totalEstimatedCost      Decimal @default(0) @db.Decimal(12, 2)

  advanceRequired      Boolean  @default(false)
  advanceAmount        Decimal? @default(0) @db.Decimal(12, 2)
  advanceRemarks       String?
  remarks              String?
  attachments          Json?

  status               String   @default("DRAFT") // DRAFT, SUBMITTED, MANAGER_APPROVED, HR_APPROVED, FINANCE_APPROVED, IN_PROGRESS, COMPLETED, REJECTED, CANCELLED
  rejectionReason      String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation?           @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  approvalHistory    TravelApprovalHistory[]
  expenseClaims      ExpenseClaim[]

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@map("travel_bookings")
}

model TravelApprovalHistory {
  id              String   @id @default(cuid())
  travelBookingId String
  userId          String?
  userName        String
  action          String   // SUBMITTED, MANAGER_APPROVED, HR_APPROVED, FINANCE_APPROVED, REJECTED, CANCELLED, COMPLETED
  remarks         String?
  createdAt       DateTime @default(now())

  travelBooking TravelBooking @relation(fields: [travelBookingId], references: [id], onDelete: Cascade)

  @@index([travelBookingId])
  @@map("travel_approval_histories")
}

model ExpenseClaim {
  id              String   @id @default(cuid())
  claimCode       String   @unique
  travelBookingId String?
  companyId       String
  employeeId      String
  title           String
  category        String   @default("Flight & Hotel")
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  date            DateTime @default(now())
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, REIMBURSED
  receiptUrl      String?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  travelBooking TravelBooking? @relation(fields: [travelBookingId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([travelBookingId])
  @@map("expense_claims")
}

// ---------------------------------------------------------------------------
// Module: Compliance - Provident Fund (PF) Enterprise Suite
// ---------------------------------------------------------------------------

enum PfRunState {
  PAYROLL_PENDING
  PF_RUN_CREATED
  CALCULATING
  CALCULATED
  VALIDATION_FAILED
  READY_FOR_ECR
  ECR_GENERATED
  ECR_SUBMITTED
  CHALLAN_CREATED
  PAYMENT_PENDING
  PAID
  RECONCILIATION_PENDING
  COMPLETED
}

model PfConfiguration {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  establishmentCode  String   @default("DLCPM0001234000")
  epfoOfficeCode      String   @default("DLCPM")
  pfWageCeiling       Decimal  @default(15000) @db.Decimal(12, 2)
  epsWageCeiling      Decimal  @default(15000) @db.Decimal(12, 2)
  edliWageCeiling     Decimal  @default(15000) @db.Decimal(12, 2)
  employeePfRate      Decimal  @default(12.00) @db.Decimal(5, 2)
  employerEpsRate     Decimal  @default(8.33) @db.Decimal(5, 2)
  employerEpfRate     Decimal  @default(3.67) @db.Decimal(5, 2)
  edliRate            Decimal  @default(0.50) @db.Decimal(5, 2)
  adminRate           Decimal  @default(0.50) @db.Decimal(5, 2)
  minAdminCharge      Decimal  @default(500) @db.Decimal(12, 2)
  epsMaxCap           Decimal  @default(1250) @db.Decimal(12, 2)
  edliMaxCap          Decimal  @default(75) @db.Decimal(12, 2)
  edliExempt          Boolean  @default(false)
  account22Applicable Boolean  @default(false)
  account22Rate       Decimal  @default(0.005) @db.Decimal(6, 4)
  account22Min        Decimal  @default(1.00) @db.Decimal(12, 2)
  allowHigherWage     Boolean  @default(true)
  restrictEpsOver58   Boolean  @default(true)
  policyVersion       String   @default("EPFO_2026_V1")
  effectiveFrom       DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("pf_configurations")
}

model PfMonthlyRun {
  id                 String       @id @default(cuid())
  companyId          String
  period             String       // e.g. "2026-09"
  status             PfRunState   @default(PF_RUN_CREATED)
  eligibleStaffCount Int          @default(0)
  totalGrossWage     Decimal      @default(0) @db.Decimal(14, 2)
  totalPfWage        Decimal      @default(0) @db.Decimal(14, 2)
  totalEpsWage       Decimal      @default(0) @db.Decimal(14, 2)
  totalEdliWage      Decimal      @default(0) @db.Decimal(14, 2)
  totalEePf          Decimal      @default(0) @db.Decimal(14, 2)
  totalVpf           Decimal      @default(0) @db.Decimal(14, 2)
  totalErEpf         Decimal      @default(0) @db.Decimal(14, 2)
  totalErEps         Decimal      @default(0) @db.Decimal(14, 2)
  totalEdli          Decimal      @default(0) @db.Decimal(14, 2)
  totalAdminCharge   Decimal      @default(0) @db.Decimal(14, 2)
  totalAcct22Charge  Decimal      @default(0) @db.Decimal(14, 2)
  totalLiability     Decimal      @default(0) @db.Decimal(14, 2)
  remarks            String?
  calculatedAt       DateTime?
  validatedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeRecords PfEmployeeRecord[]
  validations     PfValidation[]
  returns         PfReturn[]
  challans        PfChallan[]
  reconciliations PfReconciliation[]
  auditLogs       PfAuditLog[]

  @@unique([companyId, period])
  @@index([companyId])
  @@index([period])
  @@index([status])
  @@map("pf_monthly_runs")
}

model PfEmployeeRecord {
  id                String   @id @default(cuid())
  pfRunId           String
  employeeId        String
  uan               String
  memberId          String?
  employeeName      String
  period            String
  grossWage         Decimal  @default(0) @db.Decimal(12, 2)
  basicWage         Decimal  @default(0) @db.Decimal(12, 2)
  daWage            Decimal  @default(0) @db.Decimal(12, 2)
  pfWage            Decimal  @default(0) @db.Decimal(12, 2)
  epsWage           Decimal  @default(0) @db.Decimal(12, 2)
  edliWage          Decimal  @default(0) @db.Decimal(12, 2)
  ncpDays           Int      @default(0)
  employeePf        Decimal  @default(0) @db.Decimal(12, 2)
  vpfAmount         Decimal  @default(0) @db.Decimal(12, 2)
  employerEpf       Decimal  @default(0) @db.Decimal(12, 2)
  employerEps       Decimal  @default(0) @db.Decimal(12, 2)
  edli              Decimal  @default(0) @db.Decimal(12, 2)
  adminCharge       Decimal  @default(0) @db.Decimal(12, 2)
  refundOfAdvance   Decimal  @default(0) @db.Decimal(12, 2)
  epsEligible       Boolean  @default(true)
  edliApplicable    Boolean  @default(true)
  higherWage        Boolean  @default(false)
  policyVersion     String   @default("EPFO_2026_V1")
  calculationStatus String   @default("COMPUTED")
  calculatedAt      DateTime @default(now())

  pfRun    PfMonthlyRun @relation(fields: [pfRunId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([pfRunId])
  @@index([employeeId])
  @@index([uan])
  @@map("pf_employee_records")
}

model PfValidation {
  id         String   @id @default(cuid())
  pfRunId    String
  severity   String   // WARNING, ERROR, CRITICAL
  ruleCode   String   // UAN_MISSING, AADHAAR_NOT_LINKED, NCP_MISMATCH, WAGE_CEILING_EXCEEDED
  message    String
  employeeId String?
  details    Json?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  pfRun PfMonthlyRun @relation(fields: [pfRunId], references: [id], onDelete: Cascade)

  @@index([pfRunId])
  @@map("pf_validations")
}

model PfReturn {
  id              String    @id @default(cuid())
  pfRunId         String
  returnType      String    @default("ECR_V2")
  period          String
  fileName        String
  fileContent     String    @db.LongText
  recordCount     Int       @default(0)
  totalPfWageSum  Decimal   @default(0) @db.Decimal(14, 2)
  totalEeRemitted Decimal   @default(0) @db.Decimal(14, 2)
  totalErRemitted Decimal   @default(0) @db.Decimal(14, 2)
  status          String    @default("GENERATED") // GENERATED, DOWNLOADED, SUBMITTED
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  pfRun PfMonthlyRun @relation(fields: [pfRunId], references: [id], onDelete: Cascade)

  @@index([pfRunId])
  @@map("pf_returns")
}

model PfChallan {
  id                 String      @id @default(cuid())
  pfRunId            String
  trrnNumber         String?     @unique // Official EPFO Portal issued TRRN (entered or synced)
  period             String
  account1Amount     Decimal     @default(0) @db.Decimal(14, 2) // EPF EE + ER
  account2Amount     Decimal     @default(0) @db.Decimal(14, 2) // Admin Charges
  account10Amount    Decimal     @default(0) @db.Decimal(14, 2) // EPS ER
  account21Amount    Decimal     @default(0) @db.Decimal(14, 2) // EDLI Insurance
  account22Amount    Decimal     @default(0) @db.Decimal(14, 2) // EDLI Admin/Inspection
  totalChallanAmount Decimal     @default(0) @db.Decimal(14, 2)
  status             String      @default("PENDING") // PENDING, GENERATED_IN_PORTAL, PAID, VERIFIED
  dueDate            DateTime?
  challanReceiptUrl  String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  pfRun    PfMonthlyRun @relation(fields: [pfRunId], references: [id], onDelete: Cascade)
  payments PfPayment[]

  @@index([pfRunId])
  @@index([trrnNumber])
  @@map("pf_challans")
}

model PfPayment {
  id            String   @id @default(cuid())
  pfChallanId   String
  utrNumber     String   @unique
  crnNumber     String?
  paidAmount    Decimal  @default(0) @db.Decimal(14, 2)
  paymentMode   String   @default("NET_BANKING")
  bankName      String?
  paymentDate   DateTime
  paymentStatus String   @default("SUCCESS")
  receiptUrl    String?
  remarks       String?
  createdAt     DateTime @default(now())

  pfChallan PfChallan @relation(fields: [pfChallanId], references: [id], onDelete: Cascade)

  @@index([pfChallanId])
  @@index([utrNumber])
  @@map("pf_payments")
}

model PfReconciliation {
  id                 String   @id @default(cuid())
  pfRunId            String
  period             String
  payrollGlLiability Decimal  @default(0) @db.Decimal(14, 2)
  pfEngineCalc       Decimal  @default(0) @db.Decimal(14, 2)
  ecrReturnSum       Decimal  @default(0) @db.Decimal(14, 2)
  challanTrrnTotal   Decimal  @default(0) @db.Decimal(14, 2)
  bankPaidAmount     Decimal  @default(0) @db.Decimal(14, 2)
  variance           Decimal  @default(0) @db.Decimal(14, 2)
  isReconciled       Boolean  @default(false)
  discrepancies      Json?
  reconciledAt       DateTime @default(now())

  pfRun PfMonthlyRun @relation(fields: [pfRunId], references: [id], onDelete: Cascade)

  @@index([pfRunId])
  @@map("pf_reconciliations")
}

model PfAuditLog {
  id        String   @id @default(cuid())
  pfRunId   String
  fromState String
  toState   String
  actionBy  String   @default("SYSTEM")
  remarks   String?
